# Configuração de APIs para MCP
# Copie este arquivo para .env e preencha com suas chaves

# DeepSeek API (necessário para servidor MCP)
DEEPSEEK_API_KEY=sua_chave_aqui

# Qwen API (opcional)
QWEN_API_KEY=sua_chave_aqui

# Como configurar:
# 1. Copie este arquivo: cp .env.example .env
# 2. Edite o .env com suas chaves
# 3. Configure as variáveis de ambiente antes de iniciar o Kiro
#    export DEEPSEEK_API_KEY="sua_chave"
#    export QWEN_API_KEY="sua_chave"

# Para configurar automaticamente no MCP, edite .kiro/settings/mcp.json:
# Adicione no objeto "env" de cada servidor:
# "env": {
#   "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}",
#   "OPENAI_API_KEY": "${QWEN_API_KEY}"
# }